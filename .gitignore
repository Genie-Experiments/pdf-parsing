# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments (each subdir manages its own)
venv/
.venv/
**/.venv/

# env file
.env

# Dolphin model weights — lives inside pipeline/, mounted into containers.
# Mount via docker-compose: ./pipeline/hf_model:/app/hf_model
pipeline/hf_model/*.safetensors
pipeline/hf_model/*.bin
pipeline/hf_model/*.gguf
# Keep config/tokenizer files so the directory structure is committed
!pipeline/hf_model/config.json
!pipeline/hf_model/generation_config.json
!pipeline/hf_model/preprocessor_config.json
!pipeline/hf_model/special_tokens_map.json
!pipeline/hf_model/tokenizer.json
!pipeline/hf_model/tokenizer_config.json

# Data directory - contains PDF files that should not be tracked
Data/

# Results directory - ignore user-generated outputs but keep the example
Results/**
!Results/
!Results/.gitignore
!Results/ReSP_v2/
!Results/ReSP_v2/**

temp_results/
temp_raw_text/

pdfs_raw_text/

ground_truth.md

.venv
temp_data

logs/
processed_images_by_dolphin/

# mkcert local TLS certificates — generated by `make certs`, never committed
traefik/certs/*.pem
section_hierarchy_pdfs/
.ruff_cache/
.github

# macOS metadata
.DS_Store
**/.DS_Store

# Local sample input / pipeline output — not for version control
sample_input_dir/
pipeline/Output/
