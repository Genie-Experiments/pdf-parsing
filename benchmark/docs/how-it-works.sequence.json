  "cards": [
    {
      "dot": "violet",
      "title": "GenieParse - the violet lifelines",
      "items": [
        "Provider: parses on the first call, normalises on the second",
        "Pipeline: main.py, Dolphin plus nine post-processing steps",
        "Dolphin: the ByteDance layout model, and ~100% of the runtime"
      ]
    },
    {
      "dot": "emerald",
      "title": "ParseBench-Platform - the green lifelines",
      "items": [
        "parse-bench: drives the run, and owns the retry loop",
        "Dataset: 2,078 pages for parsing, ~169k rules for scoring",
        "Result files: one per page, written as the run goes"
      ]
    },
    {
      "dot": "amber",
      "title": "The three things worth remembering",
      "items": [
        "Dolphin is the whole cost, so bench-rescore is the cheap loop",
        "Progress lives in result files, not memory, so a crash resumes",
        "A failed page writes none, so the next run picks it up again"
      ]
    }
