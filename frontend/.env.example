# ── Frontend environment variables ────────────────────────────────────────────
# Copy to .env.local and fill in values before running locally.
# For Docker, these are passed as build args — see docker-compose.yml.

# Backend API base URL
# Local dev:   http://localhost:8000/api/v1
# Docker TLS:  https://localhost/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to "true" to skip Google OAuth in local dev (must match DEV_BYPASS_AUTH in backend)
# NEVER set to true in production
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
