# ─────────────────────────────────────────────────────────────────────────────
# PDF Parser — root environment variables
# Used by docker-compose. Copy to .env and fill in values.
#
# For running without Docker, see:
#   backend/.env.example   →  copy to backend/.env
#   frontend/.env.example  →  copy to frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Dev overrides (NEVER true in production) ──────────────────────────────────

# Skip Google OAuth entirely — anyone can access the app
DEV_BYPASS_AUTH=true

# Skip page quota enforcement
BYPASS_QUOTA=false

# ── Auth (required if DEV_BYPASS_AUTH is false) ───────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Google OAuth2 credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI to register: http://localhost:8000/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts with this email domain are allowed to log in
ALLOWED_EMAIL_DOMAIN=emumba.com

# ── URLs ──────────────────────────────────────────────────────────────────────

# Public URL where the API is reachable by the browser
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Public URL where the frontend is reachable (used for post-login redirect)
FRONTEND_URL=http://localhost:3000

# Session lifetime in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API URL baked into the frontend bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Database ──────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=pdf

# ── MinIO (object storage) ────────────────────────────────────────────────────

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdf-parser
# Public hostname browsers use to reach MinIO (for presigned URLs).
# In Docker the internal service name is "minio:9000" which browsers can't
# resolve — set this to the externally reachable host:port so the PDF viewer
# can load files. Default is localhost:9000, correct for local Docker.
# On a remote server change to your IP or domain: e.g. pdf.example.com:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000


# ── Quotas ────────────────────────────────────────────────────────────────────

# Pages granted to a new user on their first job submission
DEFAULT_PAGE_QUOTA=10

# Maximum PDF upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# ── OpenAI (required only if LLM pipeline processing is enabled) ──────────────

OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_TEXT=gpt-4o-mini
PROCESS_CODE_USING_LLM=false
PROCESS_FIGURES_USING_LLM=false

# ── Pipeline ──────────────────────────────────────────────────────────────────

# Dolphin batch size — hardware tuning, increase if the worker has enough RAM
DOLPHIN_MAX_BATCH_SIZE=16

# ── Worker ────────────────────────────────────────────────────────────────────

# Max concurrent pipeline jobs per worker process
WORKER_MAX_JOBS=1

# Max seconds a single pipeline job may run before ARQ kills it (default 1 hour)
WORKER_JOB_TIMEOUT=3600

# ── Traefik ───────────────────────────────────────────────────────────────────

TRAEFIK_LOG_LEVEL=WARN

# ── Cookie ────────────────────────────────────────────────────────────────────

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave blank unless API and frontend share a parent domain (e.g. .example.com)
COOKIE_DOMAIN=

# ── Pipeline batch mode (docker compose run pipeline) ────────────────────────

# HOST_DATA_DIR=/path/to/input/pdfs
# HOST_OUTPUT_DIR=/path/to/output
