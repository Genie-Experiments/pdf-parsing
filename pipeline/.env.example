# ── Input / Output ────────────────────────────────────────────────────────────

# Directory containing input PDFs (required unless using --pdf-file).
# Can also be passed via: DATA_DIRECTORY=/path uv run python main.py
#                      or: uv run python main.py --data-dir /path
#
# To process a single PDF or a single page, use CLI flags instead:
#   uv run python main.py --pdf-file /path/to/doc.pdf
#   uv run python main.py --pdf-file /path/to/doc.pdf --page 5
#
# --page extracts the given page (1-indexed) to <original_dir>/<name>_page5.pdf
# and keeps it there for future reuse, then runs the full pipeline on that page only.
DATA_DIRECTORY=

# Root directory where all pipeline outputs are written.
OUTPUT_DIRECTORY=./Results

# ── Pipeline Run Control ──────────────────────────────────────────────────────

# Skip steps whose outputs already exist (useful for re-runs after partial failures).
RESUME=false

# Start from a specific step (1–10). Step 1 = Dolphin inference.
# Set to 2 to skip Dolphin and only re-run post-processing steps.
START_FROM_STEP=1

# ── Dolphin Inference (Step 1) ────────────────────────────────────────────────

# Number of document elements decoded in parallel per batch.
# Increase for faster processing if you have enough RAM/VRAM (e.g. 32, 64).
DOLPHIN_MAX_BATCH_SIZE=16

# ── Segment Refinement (Step 5) ───────────────────────────────────────────────

# Which element types to post-process. Options: "code", "fig", "tab", "catalogue".
SEGMENTS_TO_REFINE=["code","fig","tab"]

# Use GPT-4o Vision to clean up code blocks extracted from PDFs.
PROCESS_CODE_USING_LLM=false

# Use GPT-4o Vision to generate text descriptions for figures.
PROCESS_FIGURES_USING_LLM=false

# ── OpenAI (required only if either LLM flag above is true) ──────────────────

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_TEXT=gpt-4o-mini

# ── Limits ────────────────────────────────────────────────────────────────────

# Maximum characters of markdown context sent to the LLM for OCR correction.
MAX_CONTEXT_LENGTH=5000

# Maximum characters for LLM-generated figure descriptions.
MAX_DESCRIPTION_LENGTH=1000

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level for console and file output. Options: DEBUG, INFO, WARNING, ERROR.
DEFAULT_LOG_LEVEL=INFO
