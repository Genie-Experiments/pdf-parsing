# ── Dev ───────────────────────────────────────────────────────────────────────

# Skip Google OAuth entirely in local dev. Never set true in production.
DEV_BYPASS_AUTH=false

# Skip page quota enforcement in local dev. Never set true in production.
BYPASS_QUOTA=false

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://pdf:pdf@localhost:5432/pdf_parser

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# ── MinIO / S3 ────────────────────────────────────────────────────────────────

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdf-parser
# Set true when using HTTPS / production MinIO / real S3
MINIO_SECURE=false

# ── Auth ──────────────────────────────────────────────────────────────────────

# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production 

# Google OAuth2 credentials (required when DEV_BYPASS_AUTH=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts with this email domain are allowed to log in
ALLOWED_EMAIL_DOMAIN=example.com

# Public base URL of this API — must match the redirect URI registered in Google console
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Frontend URL — users are redirected here after login
FRONTEND_URL=http://localhost:3000

# Session lifetime in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Cookie ────────────────────────────────────────────────────────────────────

# Set true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave blank unless API and frontend share a parent domain (e.g. .example.com)
COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────

CORS_ORIGINS=["http://localhost:3000"]

# ── Uploads ───────────────────────────────────────────────────────────────────

# Maximum PDF upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# ── Quotas ────────────────────────────────────────────────────────────────────

# Pages granted to a new user on their first job submission.
# Admins can override per-user limits directly in the DB:
#   UPDATE user_quota SET page_quota = 50 WHERE email = 'user@example.com';
DEFAULT_PAGE_QUOTA=10

# ── OpenAI (required only if LLM pipeline processing is enabled) ──────────────

OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_TEXT=gpt-4o-mini

# ── Pipeline (infra-level only) ───────────────────────────────────────────────
# Note: segments_to_refine, process_code_using_llm, process_figures_using_llm
# are per-request — clients pass them when submitting a job, not set here.

# Dolphin batch size — hardware tuning, increase if the worker has enough RAM
DOLPHIN_MAX_BATCH_SIZE=16

# Max concurrent pipeline jobs per worker process — tune based on available RAM/VRAM
WORKER_MAX_JOBS=4

# Max seconds a single pipeline job may run before ARQ kills it (default 1 hour)
WORKER_JOB_TIMEOUT=3600

# ── Advanced (rarely need changing) ───────────────────────────────────────────

# SQLAlchemy async connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Seconds before an SSE log stream times out (default 1 hour)
SSE_TIMEOUT_SECONDS=3600
